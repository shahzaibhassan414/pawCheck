# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets - never commit real API keys, only env.example.json
/env.json

# Cloudflare Worker build output/deps/local secrets - regenerated via
# npm install / wrangler; .dev.vars holds local-only secret values, never
# real ones (those are set via `wrangler secret put`).
/cloudflare/otp-worker/node_modules/
/cloudflare/otp-worker/dist/
/cloudflare/otp-worker/.wrangler/
/cloudflare/otp-worker/.dev.vars

# Internal dev docs - kept locally, intentionally not versioned
/CLAUDE.md
/CHANGELOG.md
/Pawcheck-prd .md
